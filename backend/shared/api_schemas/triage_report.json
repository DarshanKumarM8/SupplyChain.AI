{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TriageReport",
  "description": "Triage agent output: blast radius, buffer-diversity scores, and phased release schedule",
  "type": "object",
  "required": ["event_id", "blast_radius", "graph_mobility_score", "buffer_diversity_scores", "phased_release_schedule"],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "blast_radius": {
      "type": "object",
      "required": ["direct_affected", "tier2_cascade", "total_exposed"],
      "properties": {
        "direct_affected": { "type": "integer", "minimum": 0 },
        "tier2_cascade": { "type": "integer", "minimum": 0 },
        "total_exposed": { "type": "integer", "minimum": 0 }
      }
    },
    "graph_mobility_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "buffer_diversity_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["firm_id", "d_buffer"],
        "properties": {
          "firm_id": { "type": "string" },
          "d_buffer": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "phased_release_schedule": {
      "type": "object",
      "properties": {
        "W1": { "type": "array", "items": { "type": "string" } },
        "W3": { "type": "array", "items": { "type": "string" } },
        "W5": { "type": "array", "items": { "type": "string" } }
      }
    },
    "contingent_edges_activated": {
      "type": "integer",
      "minimum": 0
    },
    "topology_ensemble_count": {
      "type": "integer",
      "minimum": 1
    }
  }
}
